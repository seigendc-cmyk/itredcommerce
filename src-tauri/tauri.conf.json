{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "iTred Commerce",
  "version": "0.1.0",
  "identifier": "com.itred.commerce",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/build-server-bundle.mjs && node scripts/prepare-sidecar.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "iTred Commerce",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/itred-server"],
    "resources": ["resources/server/**/*"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
