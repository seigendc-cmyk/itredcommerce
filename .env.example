# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Backend server (server/) ---
# API_PORT: Port the Express API/backend server listens on.
API_PORT=4000

# DB_PATH: Path to the SQLite database file.
DB_PATH=./data/itred.db

# SESSION_SECRET: Secret used to sign session cookies. Set a long random value in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# NODE_ENV: development | production
NODE_ENV=development

# --- Supabase (DL-005 / Prompt 5 — staff/PIN auth source of truth) ---
# SUPABASE_URL: your project's API URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: the SERVICE ROLE key (not the anon key) — this
# bypasses Row Level Security and must stay server-side only. Never commit a
# real value, never send it to a client, never log it.
SUPABASE_SERVICE_ROLE_KEY=""

# TENANT_ID: which tenant this local install/dev environment is bound to.
# See ITRED_GOVERNANCE_AND_ARCHITECTURE.md DL-011. Optional as of the
# Business Profile Onboarding addendum (DL-029): a genuinely fresh install
# should leave this blank — the onboarding wizard provisions a tenant and
# persists the binding to local SQLite's installation_config table itself,
# surviving restarts without this env var ever being set by hand. Set it
# explicitly only for a dev environment you want pinned to a specific
# already-provisioned tenant.
TENANT_ID="TENANT-NYAMUTSAMBA"

# --- Fiscalization (Prompt 11) ---
# FISCAL_CREDENTIALS_KEY: base64-encoded 32-byte AES-256-GCM key used to
# encrypt/decrypt fiscal-authority credentials (ZIMRA, etc.) at rest. This
# key is NEVER sent to Supabase or logged — it must be generated once and
# then distributed out-of-band to every terminal sharing the same branch's
# fiscal registration (see ITRED_GOVERNANCE_AND_ARCHITECTURE.md's
# Fiscalization addendum). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FISCAL_CREDENTIALS_KEY=""

# --- ZIMRA fiscal device (Prompt 16, DL-073/074/075) ---
# ZIMRA_SERVICE_SECRET: shared secret this backend sends (x-zimra-service-
# secret header) when it triggers the centralized zimra-fiscal-service
# Supabase Edge Function on a staff-initiated register/syncConfig/
# renewCertificate action. Must be set to the SAME value as that Edge
# Function's own ZIMRA_SERVICE_SECRET secret (set via `supabase secrets
# set`, not here) — a manual, out-of-band deployment step this app cannot
# automate, the same class of gap as FISCAL_CREDENTIALS_KEY's distribution.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# This is NOT the same value as the Edge Function's ZIMRA_CREDENTIALS_KEY —
# this backend never holds that key at all (see
# ITRED_GOVERNANCE_AND_ARCHITECTURE.md's ZIMRA FISCALIZATION ADDENDUM,
# DL-075).
ZIMRA_SERVICE_SECRET=""

# The following are NOT Express server env vars — they are Supabase Edge
# Function secrets for zimra-fiscal-service, set via `supabase secrets set`
# (or the Supabase dashboard), listed here only so every secret this
# feature needs is documented in one place:
#   ZIMRA_SERVICE_SECRET            (same value as above)
#   ZIMRA_CREDENTIALS_KEY           (base64, 32 bytes — AES-256-GCM key
#                                    encrypting the ZIMRA device private
#                                    key at rest; generate the same way as
#                                    FISCAL_CREDENTIALS_KEY above)
#   ZIMRA_FDMS_BASE_URL             (issued directly by ZIMRA's
#                                    Fiscalisation Team at TEST
#                                    registration — never guess this)
#   SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY (Edge Functions receive these
#                                    automatically; not a manual step)
