# Rider PWA — Supabase-only (DL-002), no local backend.
#
# VITE_SUPABASE_ANON_KEY is the ANON key, not the service-role key — it is
# designed to be public/embedded in a client bundle (Supabase enforces
# access entirely through RLS for this key, same as every other browser
# client). Never put SUPABASE_SERVICE_ROLE_KEY in this app.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_TENANT_ID="TENANT-NYAMUTSAMBA"
